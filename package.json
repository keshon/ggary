{
  "name": "ggary-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "assets": "node packages/icons/build.mjs && node packages/theme-ggarry/build.mjs && node packages/theme-instrument/build-icons.mjs",
    "dev": "npm run assets && npm run dev -w @ggary/sandbox",
    "test": "npm run assets && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run assets && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
